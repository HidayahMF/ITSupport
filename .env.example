# ---------------------------------------------------------------------------
# IT Support - environment variable reference (template)
# ---------------------------------------------------------------------------
# CodeIgniter 3 does not load .env files natively. This file documents the
# environment variables the application reads via getenv()/_SERVER at runtime.
#
# Two ways to configure the application:
#   1. Copy application/config/itsupport.example.php to
#      application/config/itsupport.php and edit values there.  (simplest)
#   2. Inject these variables as real environment variables / server config
#      (e.g. Apache SetEnv, systemd Environment=, container env).
#
# Do NOT put real credentials in a committed .env file. This file is only a
# reference; the real variables must be provided by your environment.

# Base URL of the deployment, with trailing slash. Leave unset to auto-detect.
APP_BASE_URL=http://localhost:8000/

# Google Gemini API (SystemRequest "Tanya AI"). Leave unset to disable the AI feature.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Internal WhatsApp notification gateway. Leave unset to disable notifications.
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3000/api/send

# Comma-separated recipient phone numbers (international format, 628...).
WHATSAPP_RECIPIENTS=6280000000000,6280000000001